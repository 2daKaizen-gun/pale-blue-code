# Pale Blue Code — frontend build-time env. Copy to `.env` for local dev.
# Vite only exposes vars prefixed with VITE_ to the client bundle.

# NASA APOD (Astronomy Picture of the Day). Get a free key at https://api.nasa.gov/
# The bundled default "DEMO_KEY" also works but is heavily rate-limited.
VITE_NASA_API_KEY=DEMO_KEY

# Backend origin (FastAPI). Leave UNSET for local dev — the app then defaults to
# http://localhost:8000 (run `uvicorn main:app` in ../backend).
#
# ⚠️  IN PRODUCTION THIS MUST BE SET to the public backend URL, or the deployed
#     site calls localhost and every backend feature (planets, light curves, BLS,
#     vetting, the hunt) is dead. On Vercel set it in
#     Project → Settings → Environment Variables, then redeploy. See docs/deploy.md.
# VITE_API_BASE_URL=https://your-backend.up.railway.app
